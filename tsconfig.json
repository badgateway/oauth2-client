{
    "compilerOptions": {
        "module": "nodenext",
        "target": "es2019",

        "strict": true,
        "noFallthroughCasesInSwitch": true,
        "experimentalDecorators": true,
        "noUnusedLocals": true,
        "erasableSyntaxOnly": true,

        "rewriteRelativeImportExtensions": true,

        "sourceMap": true,
        "rootDir": "src",
        "outDir": "dist",
        "lib": [
          "DOM",
          "ES2019"
        ],
        "types": [
          "node"
        ],
        "declaration": true
    },
    "include": [
        "src/**/*"
    ]
}
